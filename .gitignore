# Dependencies
node_modules/

# Build artifacts
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Editor files
*.swp
*.swo
*~

# IDE
.idea/
.vscode/
*.sublime-workspace

# Everything under spec/fixtures is content, whatever its extension — a sample
# of the language this package is for. Without this, a package whose language
# uses one of the extensions above (language-log and `*.log`, say) has its own
# fixture silently kept out of the repository: `git add` says nothing, and the
# spec fails on CI opening a path that does not exist.
!spec/fixtures/**

# Local credentials and profiles
.env
.env.*
!.env.example
!.env.sample
!.env.template
.npmrc
.pypirc
.netrc
id_rsa
id_ed25519
secret-store.json
/.aws/
/.ssh/
/.ipython/
/.jupyter/
/.dev/
/capture-profile/
/state-store/
.idea/workspace.xml
*.creator.user
