{
  "name": "ide-client",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Language Server Protocol client infrastructure.",
  "keywords": [
    "lsp",
    "language-server",
    "intellisense",
    "diagnostics",
    "completion"
  ],
  "repository": "https://github.com/lumine-code/ide-client",
  "bugs": {
    "url": "https://github.com/lumine-code/ide-client/issues"
  },
  "license": "MIT",
  "main": "./lib/main",
  "files": [
    "docs",
    "keymaps",
    "lib",
    "menus",
    "spec",
    "styles"
  ],
  "types": "./lib/main.d.ts",
  "engines": {
    "lumine": "^1.0.0",
    "node": ">=24"
  },
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:zip": "node scripts/check-zip.js",
    "check:xz": "node scripts/check-xz.js",
    "check:fetch": "node scripts/check-fetch.js"
  },
  "specPackages": [
    "language-ipython",
    "ide-basedpyright",
    "documentation-view",
    "hover",
    "autocomplete"
  ],
  "configSchema": {
    "preferredServers": {
      "title": "Preferred Servers",
      "description": "Ordered adapter IDs to prefer when several applicable servers declare the same exclusive group. Other servers continue to run together.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "trace": {
      "title": "Protocol Trace",
      "description": "Log the traffic between the editor and language servers to the per-server log buffer.",
      "type": "string",
      "enum": [
        "off",
        "messages",
        "verbose"
      ],
      "default": "off"
    },
    "restartLimit": {
      "title": "Maximum Automatic Restarts",
      "description": "How many times in a row a crashed language server is restarted automatically before giving up. A server that stays up for a minute gets its restarts back.",
      "type": "integer",
      "minimum": 0,
      "default": 3
    },
    "fileOperationPreparationTimeout": {
      "title": "File Operation Preparation Timeout",
      "description": "Maximum seconds to wait for language servers to prepare file creation, reference updates or deletion. The operation is cancelled when time runs out.",
      "type": "integer",
      "minimum": 1,
      "maximum": 3600,
      "default": 30
    },
    "statusBar": {
      "title": "Status Bar",
      "description": "Indicator for the language servers this window is running.",
      "type": "object",
      "properties": {
        "enabled": {
          "title": "Enabled",
          "description": "Show the running language servers in the status bar. The item stays in place while none is running, reporting zero.",
          "type": "boolean",
          "default": true
        }
      }
    }
  },
  "providedServices": {
    "ide-client": {
      "versions": {
        "1.0.0": "provideIdeClient"
      }
    },
    "autocomplete.provider": {
      "versions": {
        "1.0.0": "provideAutocomplete"
      }
    },
    "symbol.provider": {
      "versions": {
        "1.0.0": "provideSymbol"
      }
    },
    "context-help.provider": {
      "versions": {
        "1.0.0": "provideContextHelp"
      }
    },
    "hover.signature-provider": {
      "versions": {
        "1.0.0": "provideHoverSignature"
      }
    },
    "code-format.range": {
      "versions": {
        "1.0.0": "provideCodeFormatRange"
      }
    },
    "code-format.file": {
      "versions": {
        "1.0.0": "provideCodeFormatFile"
      }
    },
    "code-format.on-type": {
      "versions": {
        "1.0.0": "provideCodeFormatOnType"
      }
    },
    "code-format.on-save": {
      "versions": {
        "1.0.0": "provideCodeFormatOnSave"
      }
    },
    "find-references.provider": {
      "versions": {
        "1.0.0": "provideFindReferences"
      }
    },
    "refactor.provider": {
      "versions": {
        "1.0.0": "provideRefactor"
      }
    },
    "intentions.list": {
      "versions": {
        "1.0.0": "provideIntentionsList"
      }
    },
    "code-lens.provider": {
      "versions": {
        "1.0.0": "provideCodeLens"
      }
    },
    "inlay-hints.provider": {
      "versions": {
        "1.0.0": "provideInlayHints"
      }
    },
    "semantic-tokens.provider": {
      "versions": {
        "1.0.0": "provideSemanticTokens"
      }
    },
    "hyperclick.provider": {
      "versions": {
        "1.0.0": "provideHyperclick"
      }
    },
    "background-tips.provider": {
      "versions": {
        "1.0.0": "provideBackgroundTips"
      }
    }
  },
  "consumedServices": {
    "code-format.executor": {
      "versions": {
        "^1.0.0": "consumeCodeFormatExecutor"
      }
    },
    "file-operations.executor": {
      "versions": {
        "^1.0.0": "consumeFileOperationsExecutor"
      }
    },
    "linter.registry": {
      "versions": {
        "^1.0.0": "consumeLinterRegistry"
      }
    },
    "busy-signal": {
      "versions": {
        "^1.0.0": "consumeBusySignal"
      }
    },
    "status-bar": {
      "versions": {
        "^1.0.0": "consumeStatusBar"
      }
    },
    "tree-view.file-operations": {
      "versions": {
        "^1.0.0": "consumeTreeViewFileOperations"
      }
    }
  },
  "dependencies": {
    "picomatch": "^4.0.7",
    "tar": "^7.5.22",
    "vscode-jsonrpc": "^9.0.3",
    "xz-decompress": "^0.2.3",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.4.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "yazl": "^3.3.1"
  }
}
