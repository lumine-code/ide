{
  "lumine-workspace": {
    "alt-i": "ide:servers"
  },

  // Actions of the server list. Their explicit action descriptors reuse these
  // command bindings as presentation metadata. `ide:show-details` is
  // deliberately absent: it is the list's primary Enter action.
  ".ide-session-menu lumine-text-editor[mini]": {
    "alt-r": "ide:restart-server",
    "alt-delete": "ide:stop-server",
    "alt-l": "ide:show-server-log",
    "alt-p": "ide:show-problems"
  },

  // Actions of the Manage Servers list, on the same terms. Enter runs whichever
  // of install and update the selected row declares primary; both stay directly
  // bound as well.
  ".ide-managed-servers lumine-text-editor[mini]": {
    "alt-i": "ide:install-server",
    "alt-u": "ide:update-server",
    "alt-delete": "ide:uninstall-server",
    "alt-c": "ide:check-server-updates"
  }
}
